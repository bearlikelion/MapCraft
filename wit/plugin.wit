package mapcraft:plugin@0.1.0;

/// Plain data shared by the host and plugins. Lengths are map units (1 unit = 1 inch), Z is up.
interface types {
    record vec3 {
        x: f64,
        y: f64,
        z: f64,
    }

    /// The value of a command parameter; choices and materials are `text`.
    variant value {
        number(f64),
        integer(s64),
        toggle(bool),
        text(string),
    }

    record number-range {
        min: f64,
        max: f64,
        step: f64,
    }

    record integer-range {
        min: s64,
        max: s64,
    }

    variant param-kind {
        number(number-range),
        integer(integer-range),
        toggle,
        choice(list<string>),
        text,
        material,
    }

    record param-spec {
        id: string,
        label: string,
        help: string,
        kind: param-kind,
        initial: value,
    }

    record param {
        id: string,
        value: value,
    }

    record command-spec {
        id: string,
        label: string,
        /// Where the command appears under the Plugins menu, such as `SurfsUp/Surf Ramp`.
        menu: string,
        params: list<param-spec>,
        /// The output lives in a group that runs the command again whenever its parameters change.
        generator: bool,
    }

    /// A file format `import-file` reads, offered under File > Import.
    record importer-spec {
        id: string,
        label: string,
        /// Extensions without the dot, such as `bsp`.
        extensions: list<string>,
    }

    /// A file format `export-file` writes, offered under File > Export and in compile profiles.
    record exporter-spec {
        id: string,
        label: string,
        /// Extensions without the dot, such as `map`; the first is the default.
        extensions: list<string>,
    }

    record manifest {
        id: string,
        name: string,
        version: string,
        commands: list<command-spec>,
        /// Whether `list-materials` lists the SDK's materials.
        materials: bool,
        importers: list<importer-spec>,
        exporters: list<exporter-spec>,
        /// Whether `validate` checks maps; the editor only asks plugins that do.
        validates: bool,
        /// Model file extensions `load-model` reads, without the dot, such as `mdl`.
        models: list<string>,
    }

    /// Editor state a command may use: the grid size and the material picked in the browser.
    record context {
        grid: f64,
        material: string,
    }

    /// A brush face: three points on its plane, clockwise seen from outside the brush.
    /// A texture axis in Valve220 form: `u = dot(p, axis) / scale + offset`, in texels.
    record tex-axis {
        axis: vec3,
        offset: f64,
        scale: f64,
    }

    record face {
        points: tuple<vec3, vec3, vec3>,
        material: string,
        /// The u and v texture axes; without them the texture is aligned to the world.
        uv: option<tuple<tex-axis, tex-axis>>,
    }

    /// Faces of a hull whose outward normal is within about 8 degrees of `normal` get `material`.
    record surface {
        normal: vec3,
        material: string,
    }

    /// The convex solid around `points`; faces no surface claims get `material`.
    record hull {
        points: list<vec3>,
        material: string,
        surfaces: list<surface>,
    }

    variant brush {
        faces(list<face>),
        hull(hull),
    }

    /// A point entity, or a brush entity when it has brushes.
    record entity {
        classname: string,
        properties: list<tuple<string, string>>,
        brushes: list<brush>,
    }

    /// Output the editor keeps together in a group named `name`.
    record group {
        name: string,
        brushes: list<brush>,
        entities: list<entity>,
    }

    /// What a command makes, around the origin; the editor moves it into place.
    record output {
        brushes: list<brush>,
        entities: list<entity>,
        groups: list<group>,
        /// Materials the output uses that the SDK lacks, with their pictures; imports keep them.
        materials: list<material-info>,
    }

    /// A brush being exported: every face with its texture axes, and the brush's corners.
    record solid {
        faces: list<face>,
        vertices: list<vec3>,
    }

    record map-entity {
        classname: string,
        properties: list<tuple<string, string>>,
    }

    variant map-node-kind {
        layer(string),
        group(string),
        entity(map-entity),
        brush(solid),
    }

    record map-node {
        /// Index of the parent in `map-data.nodes`, which always comes earlier; none at the top.
        parent: option<u32>,
        kind: map-node-kind,
    }

    /// The map an exporter writes. Prefabs and mirror copies are already resolved, and layers left
    /// out of exports and everything outside an active cordon are already removed.
    record map-data {
        /// The map's file name without its extension.
        name: string,
        /// Worldspawn's key values in order.
        %world: list<tuple<string, string>>,
        nodes: list<map-node>,
    }

    enum severity {
        warning,
        error,
    }

    /// A problem a plugin found, listed by Check for Problems.
    record issue {
        severity: severity,
        message: string,
        /// The node at fault, as an index into `map-data.nodes`; none for the map as a whole.
        node: option<u32>,
    }

    /// Triangles sharing one of the model's textures.
    record model-part {
        /// Index into `model.textures`; none draws the part plain white.
        texture: option<u32>,
        positions: list<vec3>,
        /// Texture coordinates per position, 0 to 1 across the texture with V down.
        uvs: list<tuple<f32, f32>>,
        /// Three per triangle, indexes into `positions`.
        indices: list<u32>,
    }

    /// A static model a point entity shows, in map units around the entity's origin, facing +X.
    record model {
        parts: list<model-part>,
        textures: list<image>,
    }

    /// An RGBA8 picture, rows top to bottom.
    record image {
        width: u32,
        height: u32,
        rgba: list<u8>,
    }

    /// Which channel of a picture holds a value; `gray` averages red, green and blue.
    enum channel {
        red,
        green,
        blue,
        alpha,
        gray,
    }

    /// One channel of a picture in the SDK's asset folders.
    record channel-map {
        path: string,
        channel: channel,
    }

    /// Maps the Lit view shades with, as asset folder paths; the editor reads them only for materials a map uses.
    record pbr {
        /// Tangent space normal map whose green points up the picture (OpenGL), or down with `normal-dx`.
        normal: option<string>,
        normal-dx: bool,
        /// Roughness is the map's channel times the value, or the value alone without a map; 1 is fully rough.
        roughness: option<channel-map>,
        roughness-value: f32,
        /// Metallic works like roughness; 0 is not metallic.
        metallic: option<channel-map>,
        metallic-value: f32,
        /// Ambient occlusion, which darkens only ambient light.
        ao: option<channel-map>,
    }

    /// A material for the browser. `image` is a path in the SDK's asset folders shown as its
    /// preview; without one, `color` (sRGB) is.
    record material-info {
        name: string,
        image: option<string>,
        color: option<tuple<u8, u8, u8>>,
        /// The picture itself, for a material from outside the SDK's asset folders.
        pixels: option<image>,
        /// The texture's own width and height when the preview is smaller; texture scales count these.
        size: option<tuple<u32, u32>>,
        /// Physically based maps; without them the material is fully rough and not metallic.
        pbr: option<pbr>,
    }
}

/// What the editor offers plugins. There is no other file, network or process access.
interface host {
    /// Writes a line to the editor's Output panel.
    log: func(message: string);

    /// Files in the SDK's asset folders with one of `extensions`, as `/`-separated relative paths.
    list-files: func(extensions: list<string>) -> list<string>;

    /// Reads a file from the SDK's asset folders.
    read-file: func(path: string) -> result<list<u8>, string>;

    /// Reads part of a file from the SDK's asset folders, for archives too big to read whole.
    read-range: func(path: string, offset: u64, length: u64) -> result<list<u8>, string>;
}

world plugin {
    use types.{manifest, param, context, output, material-info, map-data, issue, model, image};

    import host;

    export manifest: func() -> manifest;

    export run-command: func(id: string, params: list<param>, context: context) -> result<output, string>;

    export list-materials: func() -> result<list<material-info>, string>;

    /// Reads a file the user picked for one of the manifest's importers; `name` is its file name.
    /// The output is placed as is, in map space.
    export import-file: func(importer: string, name: string, data: list<u8>, context: context) -> result<output, string>;

    /// Writes the map in one of the manifest's export formats; the editor saves the bytes.
    export export-file: func(exporter: string, %map: map-data, context: context) -> result<list<u8>, string>;

    /// Checks the map for the game's own rules; the same map an exporter gets.
    export validate: func(%map: map-data) -> list<issue>;

    /// Full-size pictures of materials `list-materials` returned smaller, for a map that uses them;
    /// one entry per name, none for a name the plugin cannot read.
    export load-materials: func(names: list<string>) -> list<option<image>>;

    /// Reads a model a point entity names, such as `progs/ogre.mdl`, for the views; only asked
    /// for files with an extension the manifest's `models` lists.
    export load-model: func(path: string) -> result<model, string>;
}
