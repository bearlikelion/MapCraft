// The entities the MapCraft Godot addon and the Lit view read by name.
// Keep the class and key names; put your game's own entities in entities.fgd.

@SolidClass = worldspawn : "World"
[
	_lightmap_scale(float) : "Lightmap scale" : "64" : "World units per luxel of baked lighting; smaller is sharper but slower to bake and larger in the game, which takes at most 64 MB of it. A face's own lightmap scale wins."
	_bounce(integer) : "Light bounces" : 1 : "How many times baked light bounces off surfaces, 0 to 16."
	_minlight(color255) : "Minimum light" : "0 0 0 0" : "Color and brightness no baked surface falls below."
]

@BaseClass = Targetname
[
	targetname(target_source) : "Name" : : "The name other entities use to refer to this one."
]

@SolidClass color(128 128 128) = func_detail : "Geometry that does not block visibility." []

@SolidClass color(128 128 200) = func_illusionary : "Geometry players see but pass through." []

@PointClass size(-16 -16 0, 16 16 72) color(0 255 0) = info_player_start : "Where the player spawns; a Marker3D in Godot."
[
	angles(angle) : "Pitch Yaw Roll" : "0 0 0"
]

@PointClass size(-16 -16 -16, 16 16 16) color(255 255 128) = light_environment : "Sun, sky and fog for the whole map; a WorldEnvironment and a DirectionalLight3D in Godot."
[
	angles(angle) : "Sun direction (Pitch Yaw Roll)" : "50 135 0" : "The way the sunlight travels; pitch is degrees below the horizon."
	sun_color(color255) : "Sun color" : "255 245 230"
	sun_energy(float) : "Sun brightness" : "1"
	sun_spread(float) : "Sun size" : "0.5" : "Degrees across the sun's disk; bigger softens baked shadows."
	shadows(boolean) : "Shadows" : 1
	sky_top_color(color255) : "Sky color" : "77 122 191"
	sky_horizon_color(color255) : "Horizon color" : "184 204 224"
	ground_color(color255) : "Ground color" : "51 54 59" : "The sky below the horizon."
	ambient_energy(float) : "Ambient light" : "1" : "How much the sky lights surfaces the sun misses."
	fog_density(float) : "Fog density" : "0" : "Per meter, 0 to 1; 0 turns fog off and around 0.002 gives a light haze."
	fog_color(color255) : "Fog color" : "184 204 224"
	fog_enabled(choices) : "Fog enabled" : -1 : "Auto uses Fog density; Disabled overrides the density." = [ -1 : "Auto" 0 : "Disabled" 1 : "Enabled" ]
	fog_light_energy(float) : "Fog brightness" : "1"
	fog_sun_scatter(float) : "Fog sun scatter" : "0" : "0 to 1."
	fog_sky_affect(float) : "Fog sky affect" : "1" : "How much fog covers the sky, 0 to 1."
	fog_mode(choices) : "Fog mode" : 0 : "Exponential thickens with distance by the density; Depth fades in from Depth begin to Depth end, with the density as its strongest." = [ 0 : "Exponential" 1 : "Depth" ]
	fog_depth_curve(float) : "Fog depth curve" : "1" : "Depth mode, 0.00001 to 16; above 1 the fog stays thin longer."
	fog_depth_begin(float) : "Fog depth begin" : "10" : "Depth mode, meters from the camera where fog starts."
	fog_depth_end(float) : "Fog depth end" : "100" : "Depth mode, meters where fog is strongest; 0 reaches the far plane."
	fog_height(float) : "Fog height" : "0" : "Height fog, meters: below this height the fog thickens."
	fog_height_density(float) : "Fog height density" : "0" : "Height fog, -16 to 16 per meter; 0 turns it off, negative puts the fog above Fog height."
	fog_aerial_perspective(float) : "Fog aerial perspective" : "0" : "0 to 1; blends the fog color toward the sky behind it, so distant things fade into the sky."
	sky_curve(float) : "Sky horizon curve" : "0.15" : "0.001 to 1."
	ground_curve(float) : "Ground horizon curve" : "0.02" : "0.001 to 1."
	sky_energy_multiplier(float) : "Sky brightness" : "1"
	ground_energy_multiplier(float) : "Ground brightness" : "1"
	tonemap_mode(choices) : "Tonemapper" : 2 = [ 0 : "Linear" 1 : "Reinhardt" 2 : "Filmic" 3 : "ACES (viewport approximation)" 4 : "AgX (Godot only)" ]
	tonemap_exposure(float) : "Exposure" : "1" : "Before tonemapping, 0 to 64."
	tonemap_white(float) : "White point" : "1" : "0.001 to 64; used by Filmic and Reinhardt."
	adjustment_enabled(boolean) : "Color adjustments" : 0
	adjustment_brightness(float) : "Adjustment brightness" : "1" : "After tonemapping, 0 to 8."
	adjustment_contrast(float) : "Contrast" : "1" : "0 to 8."
	adjustment_saturation(float) : "Saturation" : "1" : "0 to 8, 0 is grayscale."
	glow_enabled(boolean) : "Glow" : 0 : "Bloom around bright and emissive surfaces in Godot; the editor views do not draw it."
	glow_intensity(float) : "Glow intensity" : "0.3" : "0 to 8."
	glow_strength(float) : "Glow strength" : "1" : "How far the glow spreads, 0 to 2."
	glow_bloom(float) : "Glow bloom" : "0" : "0 to 1; above 0 everything glows a little, not just bright surfaces."
	glow_hdr_threshold(float) : "Glow threshold" : "1" : "0 to 4; brightness a surface needs to glow, so lower it to make dimmer emission glow."
	glow_hdr_scale(float) : "Glow HDR scale" : "2" : "0 to 4; how strongly brightness past the threshold glows."
	glow_hdr_luminance_cap(float) : "Glow brightness cap" : "12" : "0 to 256."
	glow_mix(float) : "Glow mix" : "0.05" : "0 to 1, used by the Mix blend mode."
	glow_blend_mode(choices) : "Glow blend mode" : 1 = [ 0 : "Additive" 1 : "Screen" 2 : "Softlight" 3 : "Replace" 4 : "Mix" ]

]

@BaseClass = BakedLight
[
	_light(color255) : "Color and brightness" : "255 255 255 255" : "Red, green, blue and brightness: 255 lights a surface right at the light like a sun of brightness 1, more is brighter. With Range 0 the brightness is the light 100 units away instead. Baked into the lightmap, so it costs nothing in the game."
	range(float) : "Range" : "1024" : "Units the light reaches: full brightness at the light, easing to nothing at the range. 0 uses the falloff keys below instead."
	size(float) : "Size" : "0" : "The light's diameter in units; bigger casts softer shadows, 0 casts hard ones."
	_fifty_percent_distance(float) : "50% falloff distance" : "0" : "Units where half the light is left; 0 uses inverse square falloff instead."
	_zero_percent_distance(float) : "0% falloff distance" : "0" : "Units where the light ends, with a 50% distance; 0 uses four times the 50% distance."
	_hardfalloff(boolean) : "Hard falloff" : 0 : "Fade smoothly to nothing at the 0% distance."
	_constant_attn(float) : "Constant attenuation" : "0"
	_linear_attn(float) : "Linear attenuation" : "0"
	_quadratic_attn(float) : "Quadratic attenuation" : "1"
]

@PointClass base(BakedLight) size(-8 -8 -8, 8 8 8) color(255 255 128) = light : "A baked point light."
[
]

@PointClass base(BakedLight) size(-8 -8 -8, 8 8 8) color(255 255 128) = light_spot : "A baked spotlight."
[
	angles(angle) : "Aim (Pitch Yaw Roll)" : "-90 0 0" : "Pitch -90 points straight down."
	_inner_cone(float) : "Inner cone" : "30" : "Degrees from the aim where the light starts to fade."
	_cone(float) : "Outer cone" : "45" : "Degrees from the aim where the light ends."
	_exponent(float) : "Cone falloff" : "1" : "How the light fades between the cones."
]

@PointClass base(Targetname) studio() color(255 255 255) = prop_static : "A glTF model from the project, instanced as its scene in Godot."
[
	model(studio) : "Model" : : "Path of a .glb or .gltf file in the project, such as Assets/Models/crate.glb."
	angles(angle) : "Pitch Yaw Roll" : "0 0 0"
	scale(float) : "Scale" : "1"
	collision(choices) : "Collision" : "convex" : "Convex wraps each mesh in one hull, cheap and right for crates and rocks; Trimesh collides with the exact triangles." = [ "none" : "None" "convex" : "Convex" "trimesh" : "Trimesh" ]
]
