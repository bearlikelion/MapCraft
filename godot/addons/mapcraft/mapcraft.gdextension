[configuration]
entry_symbol = "mapcraft_library_init"
compatibility_minimum = "4.4"

[libraries]
linux.debug.x86_64 = "bin/linux/mapcraft.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/linux/mapcraft.linux.template_release.x86_64.so"
windows.debug.x86_64 = "bin/windows/mapcraft.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/windows/mapcraft.windows.template_release.x86_64.dll"
macos.debug = "bin/macos/mapcraft.macos.template_debug.universal.dylib"
macos.release = "bin/macos/mapcraft.macos.template_release.universal.dylib"
